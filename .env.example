# 코드·설정이 실제로 읽는 키만 둔다. 기능을 붙이는 PR에서 필요한 키를 추가한다.

# DB (JDBC 형식: jdbc:postgresql://호스트:5432/DB이름)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 엔티티-스키마 검사 방식. 비우면 validate (테이블이 아직 없는 DB에서는 none)
JPA_DDL_AUTO=

# 프론트가 다른 도메인에서 API 를 부를 때 허용할 주소 (쉼표 구분). 비우면 CORS 를 열지 않음
CORS_ALLOWED_ORIGINS=

# 배포 서버 전용 (infra/docker/compose.deploy.yml)
DOMAIN=
