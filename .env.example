# 코드·설정이 실제로 읽는 키만 둔다. 기능을 붙이는 PR에서 필요한 키를 추가한다.
# 복사해서 .env 로 쓴다 (.env 는 .gitignore 에 있어 커밋되지 않음).

# ---- API 서버 (services/api/src/main/resources/application.yml) ----
# DB (JDBC 형식: jdbc:postgresql://호스트:5432/DB이름). 로컬 docker compose 면 jdbc:postgresql://db:5432/mnm
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 엔티티-스키마 검사 방식. 비우면 validate (테이블은 서버 시작 시 Flyway 가 만든다)
JPA_DDL_AUTO=
# 프론트가 다른 도메인에서 API 를 부를 때 허용할 주소 (쉼표 구분). 비우면 CORS 를 열지 않음
CORS_ALLOWED_ORIGINS=
# 로그인 토큰 서명 키 (32바이트 이상, 필수). 예: openssl rand -base64 48
JWT_SECRET=
# Flyway(테이블 생성·변경)만 다른 DB 계정으로 돌릴 때. 비우면 DATABASE_USERNAME/PASSWORD 를 쓴다
# 앱 계정(DATABASE_USERNAME)을 읽기·쓰기 전용으로 나눴다면 여기에 owner 계정을 넣는다
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=
# Flyway 마이그레이션 위치. 비우면 스키마 + 시연용 계정 시드. 실서비스 DB 는 classpath:db/migration 만
FLYWAY_LOCATIONS=
# Flyway 도입 전에 psql 로 스키마를 넣어 둔 DB 를 어느 버전까지 적용된 것으로 볼지. 비우면 3 (빈 DB 에는 영향 없음)
FLYWAY_BASELINE_VERSION=
# 사진·영상·음성 원본 저장소 (S3 호환, infra/ncp/README.md Object Storage 절). ENDPOINT 를 비우면 가짜 저장소
# 로컬에서는 스테이징 버킷을 쓰지 않는다. 실제 업로드를 보려면 로컬 S3 호환 컨테이너(MinIO 등) 주소를 넣는다
STORAGE_ENDPOINT=
# 비우면 kr-standard
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- 로컬 전체 실행 (docker-compose.yml) ----
# 로컬 postgres 비밀번호. 비우면 mnm
POSTGRES_PASSWORD=

# ---- 배포 서버 전용 (infra/docker/compose.deploy.yml) ----
# nginx HTTPS 인증서 도메인
DOMAIN=
# 띄울 mnm-api 이미지 태그. 보통 비워 둠 (deploy.yml 이 커밋 SHA 로 지정, 없으면 develop)
IMAGE_TAG=

# 감시·알람 (infra/docker/monitor). 웹훅 주소를 비우면 알람은 로그에만 남는다
ALERT_WEBHOOK_URL=
# discord(기본) 또는 slack
ALERT_WEBHOOK_FORMAT=
