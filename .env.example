# 코드·설정이 실제로 읽는 키만 둔다. 기능을 붙이는 PR에서 필요한 키를 추가한다.
# 복사해서 .env 로 쓴다 (.env 는 .gitignore 에 있어 커밋되지 않음).

# ---- API 서버 (services/api/src/main/resources/application.yml) ----
# DB (JDBC 형식: jdbc:postgresql://호스트:5432/DB이름). 로컬 docker compose 면 jdbc:postgresql://db:5432/mnm
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# 엔티티-스키마 검사 방식. 비우면 validate (테이블이 아직 없는 DB에서는 none)
JPA_DDL_AUTO=
# 프론트가 다른 도메인에서 API 를 부를 때 허용할 주소 (쉼표 구분). 비우면 CORS 를 열지 않음
CORS_ALLOWED_ORIGINS=

# ---- 로컬 전체 실행 (docker-compose.yml) ----
# 로컬 postgres 비밀번호. 비우면 mnm
POSTGRES_PASSWORD=

# ---- 배포 서버 전용 (infra/docker/compose.deploy.yml) ----
# nginx HTTPS 인증서 도메인
DOMAIN=
# 띄울 mnm-api 이미지 태그. 보통 비워 둠 (deploy.yml 이 커밋 SHA 로 지정, 없으면 develop)
IMAGE_TAG=
